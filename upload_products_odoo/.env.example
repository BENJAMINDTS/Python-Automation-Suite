# ============================================================
# upload_products_odoo — Variables de Entorno
# ============================================================
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env al control de versiones.

# [REQUERIDO] URL de tu instancia de Odoo
ODOO_URL=https://tu-dominio.odoo.com

# [REQUERIDO] Nombre de la base de datos de Odoo
ODOO_DB=nombre_de_tu_base_de_datos

# [REQUERIDO] Usuario de Odoo
ODOO_USERNAME=tu_usuario

# [REQUERIDO] Contraseña del usuario de Odoo
ODOO_PASSWORD=tu_contraseña_segura

# [REQUERIDO] Ruta a la carpeta que contiene las fotos de los productos
CARPETA_FOTOS=./fotos

# [REQUERIDO] Ruta al archivo CSV con el catálogo de productos
ARCHIVO_CSV=catalogo.csv

# [OPCIONAL] Si es True, vacía todos los productos de Odoo antes de importar (por defecto: False)
# ¡PELIGRO! Esto elimina todos los productos existentes. Úsalo solo en entornos de prueba.
LIMPIAR_CATALOGO=False
