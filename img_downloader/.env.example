# ============================================================
# img_downloader — Variables de Entorno
# ============================================================
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env al control de versiones.

# [OPCIONAL] Ruta al ejecutable del navegador (si no se define, se autodetecta Opera GX en Windows)
BROWSER_BINARY_PATH=

# [OPCIONAL] Número de hilos paralelos de descarga (por defecto: 6)
WORKERS_DESCARGA=6

# [OPCIONAL] Píxeles mínimos (ancho y alto) para aceptar una imagen (por defecto: 200)
RESOLUCION_MINIMA=200

# [OPCIONAL] Segundos entre búsquedas en Bing (mínimo recomendado: 1.0) (por defecto: 1.2)
DELAY_NAVEGADOR=1.2

# [OPCIONAL] Timeout en segundos por request HTTP de imagen (por defecto: 12)
TIMEOUT_IMAGEN=12

# [OPCIONAL] Resultados de Bing a probar por producto (por defecto: 5)
MAX_INTENTOS_URL=5

# [REQUERIDO] Nombre del archivo CSV de entrada
ARCHIVO_CSV=tu_inventario.csv

# [OPCIONAL] Carpeta donde se guardan las imágenes descargadas (por defecto: imagenes_descargadas)
DIRECTORIO_SALIDA=imagenes_descargadas
