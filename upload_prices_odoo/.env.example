# ============================================================
# upload_prices_odoo — Variables de Entorno
# ============================================================
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env al control de versiones.

# [REQUERIDO] URL de tu instancia de Odoo (incluye http:// o https://)
ODOO_URL=http://localhost:8069

# [REQUERIDO] Nombre de la base de datos de Odoo
ODOO_DB=nombre_de_tu_base_de_datos

# [REQUERIDO] Usuario de Odoo
ODOO_USERNAME=tu_usuario

# [REQUERIDO] Contraseña del usuario de Odoo
ODOO_PASSWORD=tu_contraseña

# [REQUERIDO] Nombre del archivo CSV con las tarifas
ARCHIVO_TARIFAS=nombre_del_archivo.csv

# [REQUERIDO] Nombre de la columna del CSV con el precio sin IVA
COLUMNA_SIN_IVA=nombre_del_campo_sin_iva

# [REQUERIDO] Nombre de la columna del CSV con el precio con IVA
COLUMNA_CON_IVA=nombre_del_campo_con_iva

# [OPCIONAL] Nombre de la tarifa B2C en Odoo (por defecto: Tarifa PVP (Con IVA))
NOMBRE_TARIFA_ODOO=Tarifa PVP (Con IVA)
