# ============================================================
# upload_tax_odoo — Variables de Entorno
# ============================================================
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env al control de versiones.

# [REQUERIDO] URL de tu instancia de Odoo (incluye https://)
ODOO_URL=https://tu-dominio-odoo.com

# [REQUERIDO] Nombre de la base de datos de Odoo
ODOO_DB=nombre_base_datos

# [REQUERIDO] Usuario de Odoo (normalmente el email de administrador)
ODOO_USERNAME=tu_usuario@email.com

# [REQUERIDO] Contraseña del usuario de Odoo
ODOO_PASSWORD=tu_contraseña_segura

# [REQUERIDO] Nombre del archivo CSV con las tarifas a importar
ARCHIVO_TARIFAS=tarifas_ejemplo.csv

# [OPCIONAL] Columnas de tarifa a procesar (separadas por coma)
# Por defecto procesa: Tarifa PVP 2, Tarifa PVP, Tarifa PVP sin Iva, Nuevos cliente, Tarifa 15, Cliente fidelizado
# COLUMNAS_TARIFAS=Tarifa PVP 2,Tarifa PVP,Tarifa PVP sin Iva,Nuevos cliente,Tarifa 15,Cliente fidelizado
