# ============================================================
# ia_description_products_generate — Variables de Entorno
# ============================================================
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env al control de versiones.

# [REQUERIDO] Clave de autenticación para la API de Groq
GROQ_API_KEY=tu_clave_groq_aqui

# [OPCIONAL] Número de productos por lote enviado a la IA (por defecto: 10)
BATCH_SIZE=10

# [OPCIONAL] Nombre del archivo CSV de salida con los resultados generados
ARCHIVO_SALIDA=catalogo_con_descripciones.csv
