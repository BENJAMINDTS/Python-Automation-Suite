# ============================================================
# upload_customers_suppliers_odoo — Variables de Entorno
# ============================================================
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env al control de versiones.

# [REQUERIDO] URL de tu instancia de Odoo (incluye https://)
ODOO_URL=https://tu-dominio.odoo.com

# [REQUERIDO] Nombre de la base de datos de Odoo
ODOO_DB=nombre_de_tu_base_de_datos

# [REQUERIDO] Usuario de Odoo (normalmente el email de administrador)
ODOO_USERNAME=tu_usuario@empresa.com

# [REQUERIDO] Contraseña del usuario de Odoo
ODOO_PASSWORD=tu_contraseña_segura

# [OPCIONAL] Nombre del archivo CSV de clientes (por defecto: Clientes.csv)
ARCHIVO_CLIENTES=Clientes.csv

# [OPCIONAL] Nombre del archivo CSV de proveedores (por defecto: PROVEEDORES.csv)
ARCHIVO_PROVEEDORES=PROVEEDORES.csv

# [OPCIONAL] Codificación del CSV (por defecto: latin-1 para tildes y Ñ)
ENCODING_CSV=latin-1
